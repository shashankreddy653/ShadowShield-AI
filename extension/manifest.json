{
    "manifest_version": 3,

    "name": "ShadowShield AI",
    "version": "1.0.0",

    "description": "AI-powered website risk detection and personal data leak protection.",

    "permissions": [
        "tabs",
        "webNavigation"
    ],

    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "warning.html",
                "warning.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}